# Copy to .env in this directory, then fill in.
#   cp contrib/cloudflare-tunnel/.env.template contrib/cloudflare-tunnel/.env

# The hostname users will visit, WITHOUT the https:// prefix.
#   quick tunnel -> the *.trycloudflare.com name printed in the cloudflared logs
#   named tunnel -> your own hostname, e.g. trench.example.com
DOMAIN=

# Signs every JWT and keys stored player variables. Generate once and keep it:
# changing it logs everyone out and orphans their saved data.
#   openssl rand -hex 24
SECRET_KEY=

# Named tunnel only. From the Cloudflare Zero Trust dashboard:
# Networks -> Tunnels -> Create a tunnel -> copy the token.
# Leave empty when using the quick profile.
CF_TUNNEL_TOKEN=

# Credentials for the web map editor.
MAP_STORAGE_AUTHENTICATION_USER=admin
MAP_STORAGE_AUTHENTICATION_PASSWORD=

# --- optional -------------------------------------------------------------

# Image tag. "master" tracks upstream; pin to a master-<sha> tag for
# reproducible restarts. All images publish linux/amd64 and linux/arm64.
VERSION=master

# The map players spawn into. Defaults to the upstream starter kit.
#START_ROOM_URL=/_/global/workadventure.github.io/map-starter-kit/office.tmj

# Max users per conversation bubble. Above 4 WorkAdventure wants an SFU
# (LiveKit), which cannot run behind a tunnel — see README. Leave at 4.
MAX_PER_GROUP=4

ENABLE_MAP_EDITOR=true
DISABLE_ANONYMOUS=false

STUN_SERVER=stun:stun.l.google.com:19302
UPLOAD_MAX_FILESIZE=10485760

LOG_LEVEL=WARN
RESTART_POLICY=unless-stopped
